# --- API ---
DATABASE_URL=postgresql+psycopg://peblo:peblo@postgres:5432/peblo
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
PUBLIC_BASE_URL=http://localhost:8000

# Seed demo users (override in production — never ship these)
ADMIN_EMAIL=admin@peblo.local
ADMIN_PASSWORD=peblo-admin
EDITOR_EMAIL=editor@peblo.local
EDITOR_PASSWORD=peblo-editor

SEED_ON_STARTUP=true
SEED_SHOWS_PATH=/seed/seed_shows.json
REFERENCE_PATH=/seed/reference.json

# --- Storage ---
# local | r2
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/storage

# Only needed when STORAGE_BACKEND=r2 (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=peblo-tv
R2_PUBLIC_BASE_URL=

# --- Frontends (baked in at image build) ---
VITE_API_URL=http://localhost:8000
